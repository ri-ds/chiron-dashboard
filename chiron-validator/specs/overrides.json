          {"name": "extended_table_def", "type": "object", "required": true, "nullable": false, "strict_extra": false},
          {"name": "pipeline", "type": "string", "required": true, "nullable": false}
        ]
      }
    },
    {
      "key": "v1|GET|/api/report_tools/{pk}/preview/|preview",
      "purpose": "v1 report preview (same envelope as v2).",
      "response_contract": {
        "kind": "object", "strict_extra": true,
        "fields": [
          {"name": "warnings", "type": "array", "required": true, "nullable": false},
          {"name": "errors", "type": "array", "required": true, "nullable": false},
          {"name": "record_count", "type": "integer", "required": true, "nullable": false},
          {"name": "subject_count", "type": "integer", "required": true, "nullable": false},
          {"name": "paginator", "type": "object", "required": true, "nullable": false, "strict_extra": false},
          {"name": "extended_table_def", "type": "object", "required": true, "nullable": false, "strict_extra": false},
          {"name": "data", "type": "array", "required": true, "nullable": false}
        ]
      }
    },
    {
      "key": "v2|GET|/api/v2/{dataset_string}/concepts/|list",
      "purpose": "Paginated list of concepts (ConceptSerializer v2).",
